        {
          "info": {
            "name": "Get Required Variables",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/campaigns/:campaign_id/variables",
            "params": [
              {
                "name": "campaign_id",
                "value": "",
                "type": "path",
                "description": "The ID of the campaign to get the variables from."
              }
            ]
          },
          "docs": "If successful returns a json with the needed variables for the campaign."
        },
        {

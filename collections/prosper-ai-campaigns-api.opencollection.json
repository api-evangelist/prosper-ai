            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add targets to a campaign"
        },
        {
          "info": {
            "name": "Delete Targets",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/campaigns/:campaign_id/targets",
            "params": [
              {
                "name": "campaign_id",
                "value": "",
                "type": "path",
                "description": "The ID of the campaign to delete targets from."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete targets from a campaign"
